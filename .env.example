# ==============================================================================
# HEALTH OS — Variables de Entorno (100% Free Stack)
# ==============================================================================

# 1. Base de Datos Lakebase Postgres en Neon (generadas automáticamente con `neon deploy` o `neon env pull`)
DATABASE_URL="postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. PIN numérico personal de desbloqueo (4 a 8 dígitos). Cero registro, cookie HttpOnly de 90 días.
APP_PIN="2580"

# 3. API Key gratuita de Google AI Studio (https://aistudio.google.com/apikey)
# Usa gemini-2.5-flash en su capa gratuita (sin tarjeta de crédito).
# Si se deja vacío, la app funciona igual con un estimador local de respaldo.
GEMINI_API_KEY="AIzaSy..."

# Opcional: Semilla secreta para firmar el token del PIN (si se omite, deriva de APP_PIN)
AUTH_SECRET="health-os-single-user-secret-v1"
